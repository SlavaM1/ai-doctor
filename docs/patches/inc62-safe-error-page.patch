+package com.example.InternetStore.controller;
+
+import com.example.InternetStore.utils.error.ErrorHtmlRenderer;
+import java.nio.charset.StandardCharsets;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.MediaType;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.ControllerAdvice;
+import org.springframework.web.bind.annotation.ExceptionHandler;
+import org.springframework.web.servlet.ModelAndView;
+
+import javax.servlet.http.HttpServletRequest;
+import javax.servlet.http.HttpServletResponse;
+import java.io.IOException;
+
+/**
+ * Глобальный обработчик ошибок: рендерит простую HTML-страницу напрямую,
+ * чтобы не зависеть от наличия шаблона Thymeleaf "error".
+ */
+@ControllerAdvice
+public class GlobalExceptionHandler {
+
+    private static final Logger log = LoggerFactory.getLogger(GlobalExceptionHandler.class);
+
+    static final String FALLBACK_HTML = ErrorHtmlRenderer.renderErrorPage();
+
+    @ExceptionHandler(Exception.class)
+    public ModelAndView handleAnyException(Exception ex, HttpServletRequest request, HttpServletResponse response) throws IOException {
+        HttpStatus status = ErrorHtmlRenderer.statusFor(ex);
+        if (!response.isCommitted() && ex instanceof org.springframework.web.HttpRequestMethodNotSupportedException) {
+            String[] supported = ((org.springframework.web.HttpRequestMethodNotSupportedException) ex).getSupportedMethods();
+            if (supported != null) {
+                response.setHeader("Allow", String.join(", ", supported));
+            }
+        }
+        if (status.is5xxServerError()) {
+            log.error("Unhandled request exception; returning safe HTML", ex);
+        }
+        ErrorHtmlRenderer.write(response, status);
+        return null;
+    }
+
+    static ResponseEntity<String> buildFallbackResponse() {
+        return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR)
+                .contentType(new MediaType(MediaType.TEXT_HTML, StandardCharsets.UTF_8))
+                .body(FALLBACK_HTML);
+    }
+}
