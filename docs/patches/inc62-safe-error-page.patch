+package com.example.InternetStore.utils.error;
+
+import java.io.IOException;
+
+import javax.servlet.http.HttpServletResponse;
+
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+/**
+ * Безопасная обработка необработанных исключений: отдаёт статический текст
+ * без использования Thymeleaf, чтобы исключить каскадную ошибку рендеринга
+ * шаблона error и утечку stack trace.
+ */
+// Compatibility helper only. GlobalExceptionHandler is the sole MVC advice.
+public class SafeErrorHandler {
+
+    private static final Logger log = LoggerFactory.getLogger(SafeErrorHandler.class);
+
+    public static final String FALLBACK_MESSAGE = ErrorHtmlRenderer.MESSAGE;
+
+    public void handleException(Exception ex, HttpServletResponse response) throws IOException {
+        log.error("Unhandled exception, returning safe error response", ex);
+        ErrorHtmlRenderer.write(response, ErrorHtmlRenderer.statusFor(ex));
+    }
+}
diff --git a/src/test/java/com/example/InternetStore/controller/ErrorPageMvcRegressionTest.java b/src/test/java/com/example/InternetStore/controller/ErrorPageMvcRegressionTest.java
new file mode 100644
index 0000000..f09e2c6
--- /dev/null
+++ b/src/test/java/com/example/InternetStore/controller/ErrorPageMvcRegressionTest.java
@@ -0,0 +1,137 @@
+package com.example.InternetStore.controller;
+
+import com.example.InternetStore.utils.error.ErrorHtmlRenderer;
+import com.example.InternetStore.utils.error.SafeErrorController;
+import java.nio.charset.StandardCharsets;
+import javax.servlet.RequestDispatcher;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.MediaType;
+import org.springframework.stereotype.Controller;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.setup.MockMvcBuilders;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestParam;
+import org.springframework.web.bind.annotation.ResponseBody;
+import org.springframework.web.server.ResponseStatusException;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.*;
+
+class ErrorPageMvcRegressionTest {
+    private MockMvc mvc;
+
+    @Controller
+    static class FailingController {
+        @GetMapping("/test-error")
+        public void error() { throw new NumberFormatException("secret-internal-value"); }
+
+        @GetMapping("/test-not-found")
+        public void notFound() { throw new ResponseStatusException(HttpStatus.NOT_FOUND, "secret-resource"); }
+
+        @PostMapping("/test-post-only")
+        @ResponseBody
+        public String postOnly() { return "ok"; }
+
+        @GetMapping("/test-required")
+        @ResponseBody
+        public String required(@RequestParam("id") int id) { return Integer.toString(id); }
+    }
+
+    @BeforeEach
+    void setup() {
+        mvc = MockMvcBuilders.standaloneSetup(new FailingController(), new SafeErrorController())
+                .setControllerAdvice(new GlobalExceptionHandler()).build();
+    }
+
+    @Test
+    void unhandledMvcExceptionReturnsStyledSafeUtf8Html() throws Exception {
+        String html = mvc.perform(get("/test-error"))
+                .andExpect(status().isInternalServerError())
+                .andExpect(content().contentTypeCompatibleWith(MediaType.TEXT_HTML))
+                .andExpect(header().string("Cache-Control", "no-store"))
+                .andReturn().getResponse().getContentAsString(StandardCharsets.UTF_8);
+        assertEquals(ErrorHtmlRenderer.renderErrorPage(), html);
+        assertTrue(html.contains(ErrorHtmlRenderer.MESSAGE));
+        assertTrue(html.contains("AurelSpa"));
+        assertTrue(html.contains("Вернуться на главную"));
+        assertFalse(html.contains("secret-internal-value"));
+        assertFalse(html.contains("NumberFormatException"));
+        assertFalse(html.contains("java.lang"));
+    }
+
+    @Test
+    void servletErrorUsesSameHtmlAndPreserves404And500() throws Exception {
+        for (int code : new int[]{404, 500}) {
+            mvc.perform(get("/error").requestAttr(RequestDispatcher.ERROR_STATUS_CODE, code)
+                            .requestAttr(RequestDispatcher.ERROR_EXCEPTION, new RuntimeException("secret-error")))
+                    .andExpect(status().is(code))
+                    .andExpect(content().contentTypeCompatibleWith(MediaType.TEXT_HTML))
+                    .andExpect(content().string(ErrorHtmlRenderer.renderErrorPage()));
+        }
+    }
+
+    @Test
+    void responseStatusExceptionPreserves404WithoutDetails() throws Exception {
+        mvc.perform(get("/test-not-found"))
+                .andExpect(status().isNotFound())
+                .andExpect(content().string(ErrorHtmlRenderer.renderErrorPage()));
+    }
+
+    @Test
+    void invalidErrorStatusCannotBecomeSuccess() throws Exception {
+        mvc.perform(get("/error").requestAttr(RequestDispatcher.ERROR_STATUS_CODE, 200))
+                .andExpect(status().isInternalServerError());
+    }
+
+    @Test
+    void mvcClientErrorsPreserve400And405() throws Exception {
+        mvc.perform(get("/test-post-only"))
+                .andExpect(status().isMethodNotAllowed())
+                .andExpect(header().string("Allow", "POST"))
+                .andExpect(content().string(ErrorHtmlRenderer.renderErrorPage()));
+        mvc.perform(get("/test-required"))
+                .andExpect(status().isBadRequest())
+                .andExpect(content().string(ErrorHtmlRenderer.renderErrorPage()));
+        mvc.perform(get("/test-required").param("id", "not-a-number"))
+                .andExpect(status().isBadRequest())
+                .andExpect(content().string(ErrorHtmlRenderer.renderErrorPage()));
+    }
+
+    @Test
+    void servletErrorResetsOldEncodingAndDoesNotAppendAfterCommit() throws Exception {
+        org.springframework.mock.web.MockHttpServletRequest request = new org.springframework.mock.web.MockHttpServletRequest();
+        request.setAttribute(RequestDispatcher.ERROR_STATUS_CODE, 500);
+        org.springframework.mock.web.MockHttpServletResponse response = new org.springframework.mock.web.MockHttpServletResponse();
+        response.setHeader("Content-Encoding", "gzip");
+        response.setHeader("X-Trace-Id", "servlet-trace");
+        response.getOutputStream().write(new byte[]{1, 2, 3});
+        new SafeErrorController().handleError(request, response);
+        assertNull(response.getHeader("Content-Encoding"));
+        assertEquals("servlet-trace", response.getHeader("X-Trace-Id"));
+        assertEquals(ErrorHtmlRenderer.renderErrorPage(), response.getContentAsString(StandardCharsets.UTF_8));
+        response.flushBuffer();
+        new SafeErrorController().handleError(request, response);
+        assertEquals(ErrorHtmlRenderer.renderErrorPage(), response.getContentAsString(StandardCharsets.UTF_8));
+    }
+
+    @Test
+    void rendererPreservesTracingHeaderAndDoesNotRewriteCommittedResponse() throws Exception {
+        org.springframework.mock.web.MockHttpServletResponse response = new org.springframework.mock.web.MockHttpServletResponse();
+        response.setHeader("X-Trace-Id", "test-trace");
+        response.setHeader("X-Content-Type-Options", "nosniff");
+        response.setContentLength(99999);
+        response.getWriter().write("old partial body");
+        ErrorHtmlRenderer.write(response, HttpStatus.INTERNAL_SERVER_ERROR);
+        assertEquals("test-trace", response.getHeader("X-Trace-Id"));
+        assertEquals("nosniff", response.getHeader("X-Content-Type-Options"));
+        assertNull(response.getHeader("Content-Length"));
+        assertEquals(ErrorHtmlRenderer.renderErrorPage(), response.getContentAsString());
+        response.flushBuffer();
+        ErrorHtmlRenderer.write(response, HttpStatus.NOT_FOUND);
+        assertEquals(500, response.getStatus());
+        assertEquals(ErrorHtmlRenderer.renderErrorPage(), response.getContentAsString());
+    }
+}
