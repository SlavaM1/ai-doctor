+package com.example.InternetStore.utils.error;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import javax.servlet.http.HttpServletResponse;
+import org.springframework.core.annotation.AnnotatedElementUtils;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.server.ResponseStatusException;
+
+/** Self-contained error view: no template engine, database or external assets. */
+public final class ErrorHtmlRenderer {
+    public static final String MESSAGE = "произошла ошибка, обратитесь к администратору сайта";
+    private static final String HTML = """
+            <!doctype html>
+            <html lang="ru">
+            <head>
+              <meta charset="utf-8">
+              <meta name="viewport" content="width=device-width, initial-scale=1">
+              <title>Произошла ошибка — АурельSpa</title>
+              <style>
+                *{box-sizing:border-box}
+                body{margin:0;background:#fffaff;color:#342c40;font:17px/1.65 Arial,sans-serif}
+                main{min-height:100vh;min-height:100svh;display:grid;place-content:center;
+                  max-width:760px;margin:auto;padding:48px 24px;text-align:center}
+                .brand{font:32px Georgia,serif;letter-spacing:.02em;color:inherit;text-decoration:none}
+                .bloom{width:104px;height:104px;margin:44px auto 30px;color:#9d8ccd}
+                h1{margin:0 0 18px;font:clamp(32px,6vw,48px)/1.15 Georgia,serif;font-weight:400}
+                p{max-width:39ch;margin:0 auto 32px;color:#62576b;overflow-wrap:break-word}
+                .home{display:inline-block;justify-self:center;padding:13px 28px;border-radius:25px;
+                  background:linear-gradient(100deg,#acaaff,#fbbaf8);color:#342c40;
+                  text-decoration:none;font-size:15px;font-weight:bold}
+                a:focus-visible{outline:3px solid #6d5689;outline-offset:5px}
+                .home:hover{background:#e3cefa}
+                footer{margin-top:56px;color:#766780;font-size:13px}
+              </style>
+            </head>
+            <body>
+              <main>
+                <a class="brand" href="/" aria-label="АурельSpa — на главную">AurelSpa</a>
+                <svg class="bloom" viewBox="0 0 104 104" fill="none" aria-hidden="true">
+                  <path d="M52 85C22 72 14 43 20 24c17 1 29 12 32 28 3-16 15-27 32-28 6 19-2 48-32 61Z"
+                    stroke="currentColor" stroke-width="1.5"/>
+                  <path d="M52 85C33 65 32 37 52 12c20 25 19 53 0 73Z"
+                    fill="#f3e5fa" stroke="currentColor" stroke-width="1.5"/>
+                  <path d="M52 85V43" stroke="currentColor" stroke-width="1.5"/>
+                </svg>
+                <h1>Произошла ошибка</h1>
+                <p>произошла ошибка, обратитесь к администратору сайта</p>
+                <a class="home" href="/">Вернуться на главную</a>
+                <footer>АурельSpa · территория оздоровления и косметологии</footer>
+              </main>
+            </body>
+            </html>
+            """;
+
+    private ErrorHtmlRenderer() {}
+
+    public static String renderErrorPage() {
+        return HTML;
+    }
+
+    public static HttpStatus statusFor(Exception exception) {
+        if (exception instanceof org.springframework.web.HttpRequestMethodNotSupportedException) {
+            return HttpStatus.METHOD_NOT_ALLOWED;
+        }
+        if (exception instanceof org.springframework.web.HttpMediaTypeNotSupportedException) {
+            return HttpStatus.UNSUPPORTED_MEDIA_TYPE;
+        }
+        if (exception instanceof org.springframework.web.HttpMediaTypeNotAcceptableException) {
+            return HttpStatus.NOT_ACCEPTABLE;
+        }
+        if (exception instanceof org.springframework.web.servlet.NoHandlerFoundException) {
+            return HttpStatus.NOT_FOUND;
+        }
+        if (exception instanceof org.springframework.web.context.request.async.AsyncRequestTimeoutException) {
+            return HttpStatus.SERVICE_UNAVAILABLE;
+        }
+        if (exception instanceof org.springframework.web.multipart.MaxUploadSizeExceededException) {
+            return HttpStatus.PAYLOAD_TOO_LARGE;
+        }
+        if (exception instanceof org.springframework.security.access.AccessDeniedException) {
+            return HttpStatus.FORBIDDEN;
+        }
+        // These failures are server-side, despite being binding/type exceptions.
+        if (exception instanceof org.springframework.beans.ConversionNotSupportedException
+                || exception instanceof org.springframework.web.bind.MissingPathVariableException) {
+            return HttpStatus.INTERNAL_SERVER_ERROR;
+        }
+        if (exception instanceof org.springframework.web.bind.ServletRequestBindingException
+                || exception instanceof org.springframework.beans.TypeMismatchException
+                || exception instanceof org.springframework.http.converter.HttpMessageNotReadableException
+                || exception instanceof org.springframework.validation.BindException
+                || exception instanceof org.springframework.web.multipart.support.MissingServletRequestPartException) {
+            return HttpStatus.BAD_REQUEST;
+        }
+        if (exception instanceof ResponseStatusException) {
+            return errorStatus(((ResponseStatusException) exception).getStatus().value());
+        }
+        ResponseStatus annotation = AnnotatedElementUtils.findMergedAnnotation(exception.getClass(), ResponseStatus.class);
+        return annotation == null ? HttpStatus.INTERNAL_SERVER_ERROR : errorStatus(annotation.code().value());
+    }
+
+    public static HttpStatus errorStatus(int code) {
+        HttpStatus status = HttpStatus.resolve(code);
+        return code >= 400 && code <= 599 && status != null ? status : HttpStatus.INTERNAL_SERVER_ERROR;
+    }
+
+    public static void write(HttpServletResponse response, HttpStatus status) throws IOException {
+        if (response.isCommitted()) {
+            return;
+        }
+        // resetBuffer does not release an already acquired ISO-8859-1 writer.
+        // Reset its encoding too, preserving security/cookie/tracing headers but
+        // not headers describing the old, discarded representation.
+        Map<String, List<String>> headers = new LinkedHashMap<>();
+        for (String name : response.getHeaderNames()) {
+            String lower = name.toLowerCase(Locale.ROOT);
+            if (!List.of("content-type", "content-length", "content-encoding", "etag", "last-modified").contains(lower)) {
+                headers.put(name, new ArrayList<>(response.getHeaders(name)));
+            }
+        }
+        response.reset();
+        headers.forEach((name, values) -> values.forEach(value -> response.addHeader(name, value)));
+        response.setStatus(status.value());
+        response.setCharacterEncoding(StandardCharsets.UTF_8.name());
+        response.setContentType("text/html;charset=UTF-8");
+        response.setHeader("Cache-Control", "no-store");
+        response.getOutputStream().write(HTML.getBytes(StandardCharsets.UTF_8));
+    }
+}
