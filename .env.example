# Copy to .env (chmod 600); never commit real values.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Leave blank to discover Flash/Pro from the provider /models API.
DEFAULT_DIAGNOSIS_MODEL=
DEFAULT_FIX_MODEL=
MAX_CONTEXT_TOKENS=18000
MAX_OUTPUT_TOKENS=3000
MAX_AGENT_ITERATIONS=12
# Supported maxima: 200 model calls/task, 128000 context, 16000 output tokens.
# Tools: 1000 calls/task. Higher limits can substantially increase provider cost.
MAX_LLM_CONCURRENCY=1
RUNNER_TOKEN=generate-with-python-secrets-token-hex-32
ALLOWED_SERVICES=spring
COMPOSE_PROJECT=day35-aurelspa
SOURCE_REPO=/home/slava/ai/aurelSpa-day35
WORKSPACE_ROOT=/home/slava/ai/ai-doctor-workspaces
TARGET_COMPOSE_FILE=/home/slava/ai/aurelSpa-day35/compose.yaml
# Full local stack: preserve SMTP overrides during release and rollback.
DEPLOYMENT_COMPOSE_FILE=/home/slava/ai/ai-doctor/compose.yaml
# For direct docker compose commands; scripts/start.sh derives this from clean Git HEAD.
SOURCE_REVISION=replace-with-git-rev-parse-HEAD-of-target-worktree
TARGET_HEALTH_URL=http://127.0.0.1:8085/health
TARGET_SMOKE_URL=http://127.0.0.1:8085/
TARGET_DEMO_URL=http://127.0.0.1:8085/doctor-demo/normalize
# Use the target worktree's DOCTOR_DEMO_TOKEN; local verification only.
DEMO_TOKEN=
WARN_THRESHOLD=3
WARN_WINDOW_SECONDS=60
DIAGNOSIS_COOLDOWN_SECONDS=900
RETENTION_DAYS=30
